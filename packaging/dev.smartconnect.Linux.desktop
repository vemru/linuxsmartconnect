[Desktop Entry]
Type=Application
Name=Smart Connect
GenericName=Phone Companion
Comment=Connect, mirror and reply to notifications from your Motorola phone
Exec=smartconnect-gui
Icon=dev.smartconnect.Linux
Terminal=false
Categories=Network;GTK;
Keywords=phone;motorola;mirror;notifications;
StartupNotify=true
StartupWMClass=dev.smartconnect.Linux
DBusActivatable=false
X-GNOME-UsesNotifications=true
Actions=Webcam;Mirror;

[Desktop Action Webcam]
Name=Start Webcam
Exec=smartconnect-webcam --start

[Desktop Action Mirror]
Name=Mirror Phone Screen
Exec=smartconnect-mirror
