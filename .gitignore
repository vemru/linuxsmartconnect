/target
/dist
**/target/

# Local, machine-specific notes and config
CLAUDE.local.md
/.cargo/config.toml
.notes/

# Never commit research material, captures, or secrets
*.pcap
*.pcapng
*.etl
*.KEEP-PRIVATE*
config.json
*.apk
*.dll
*.log

# Databases and SQLite state
*.db
*.db-shm
*.db-wal
*.db-*
*.sqlite
*.sqlite3

# Temporary files and caches
*.tmp
*.temp
*~
*.swp
*.swo
.DS_Store
.cache/
*.cache/
__pycache__/
*.pyc

# IDEs and editors
.idea/
.vscode/

# Noctalia keeps a plugin's per-user settings in the plugin directory, so a linked
# (install.sh --link) plugin writes them into the checkout
/noctalia-plugin/smart-connect/settings.json

# makepkg output (packaging/arch)
/packaging/arch/src/
/packaging/arch/pkg/
/packaging/arch/*.pkg.tar*

# Secrets, state, and credentials
*.pem
*.key
*.der
identity.json
paired.json
pairing-qr.svg
sessions/
*.token
.env
files-identity/

# Audit reports
RELEASE_AUDIT.md
